# Vercel AI Gateway — https://vercel.com/ai-gateway
# Locally: create a key in the AI Gateway dashboard. On Vercel, run `vercel env pull` (OIDC token is used automatically).
AI_GATEWAY_API_KEY=

# Optional: live flight + hotel prices via SerpApi (Google Flights / Google Hotels).
# Free plan: 250 searches/month, no card. Leave blank to use labelled estimates.
# Results are cached for 30 minutes per server instance to save quota.
SERPAPI_KEY=

# Optional: change the model / fallbacks (any "provider/model" the gateway supports)
# AGENT_MODEL=openai/gpt-oss-120b
# AGENT_FALLBACKS=spacexai/grok-4.1-fast-non-reasoning,openai/gpt-4o-mini

# Optional: affiliate id stamped on every booking redirect
# AFFILIATE_ID=your_id
